DATABASE_URL=sqlite:///./dev.db
# Dev-only value (must be >= 32 bytes). Use a long random secret in production.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-in-production
ACCESS_TOKEN_DAYS=7
COOKIE_SECURE=false
# "development" (default) or "production". In production the app refuses to start unless
# JWT_SECRET is not the dev default and has >= 32 characters, and COOKIE_SECURE=true.
ENVIRONMENT=development
# Built frontend served by the API when the directory exists (the Docker image sets it).
FRONTEND_DIST_DIR=../frontend/dist
# Production Postgres example (placeholder): postgresql+psycopg://user:password@host:5432/dbname

# Per-IP attempts per window on login / register (0 disables); see docs/tech-spec.md section 5
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_REGISTER_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
# X-Forwarded-For entries counted from the right to reach the client IP (0 = use the socket IP; 3 on Render: client, Cloudflare, Render load balancer). See README "Production".
TRUSTED_PROXY_COUNT=0
# Set by Render (commit SHA of the running deploy); reported by /api/health.
# RENDER_GIT_COMMIT=
